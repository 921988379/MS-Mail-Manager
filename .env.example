# 一点微软工具箱配置示例，请复制为自己的 env 文件使用，不要提交真实密钥
RTWEB_HOST=127.0.0.1
RTWEB_PORT=18080
RTWEB_DB=/www/server/rtweb/app.db
RTWEB_LOGIN_USERNAME=rtweb
RTWEB_LOGIN_PASSWORD=change-me-login-password
RTWEB_ADMIN_PASSWORD=change-me-admin-password
RTWEB_SESSION_SECRET=change-me-long-random-session-secret
RTWEB_DATA_KEY=change-me-long-random-data-key
RTWEB_COOKIE_SECURE=1
RTWEB_API_ALLOW_QUERY_KEY=0
RTWEB_API_RATE_LIMIT_PER_MINUTE=60
RTWEB_API_RATE_LIMIT_PER_DAY=2000
RTWEB_BATCH_MAX_RUNNING=2

# 自动更新：默认关闭。确认部署路径、权限、备份策略后再开启。
RTWEB_AUTO_UPDATE_ENABLED=0
RTWEB_UPDATE_REPO=https://github.com/921988379/MS-Mail-Manager.git
RTWEB_UPDATE_BRANCH=main
RTWEB_UPDATE_COMMAND=git pull --ff-only origin main && python3 -m py_compile app.py && systemctl restart rtweb
